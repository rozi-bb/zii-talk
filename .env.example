# ── LLM (isi minimal satu) ───────────────────────────────
# Dipakai buat model "GPT-5.6 Luna" (default)
OPENAI_API_KEY=

# Dipakai buat model "DeepSeek V4 Flash"
DEEPSEEK_API_KEY=

# ── Azure Speech (buat ngomong & dengerin) ───────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# Suara Zii. Ganti kalau mau suara lain.
AZURE_TTS_VOICE=en-US-AriaNeural

# ── LangSmith: trace, observability, Studio ──────────────
# Ambil di https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=zii-talk

# Kalau akun LangSmith kamu BUKAN region US, wajib diisi.
# EU: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=

# ── Postgres (container dari docker-compose.yml) ─────────
# Kosong = pakai default di bawah. Ganti kalau port di compose diganti.
# DATABASE_URL=postgresql://zii:zii@127.0.0.1:5439/zii_talk

# ── Server ───────────────────────────────────────────────
PORT=8787
